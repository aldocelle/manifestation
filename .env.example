PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
DATA_DIR=.data
# Optional. Keys remain on the server. Generation has provider costs.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
AI_DAILY_LIMIT=5
# Optional automatic email. Requires a verified sending domain.
RESEND_API_KEY=
MAIL_FROM=Manifestation <inspiracion@example.com>
# Set true when deployed behind HTTPS
COOKIE_SECURE=false
